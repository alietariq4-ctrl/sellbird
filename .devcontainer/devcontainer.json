{
  "name": "Sellbird",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": "pip install --user -e '.[deliverability]' && python -m playwright install --with-deps chromium && (test -e .env || cp .env.example .env)",
  "forwardPorts": [5555],
  "portsAttributes": {
    "5555": {
      "label": "Sellbird dashboard",
      "requireLocalPort": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
